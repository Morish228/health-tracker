# Copy to .env. The service also reads ../backend/.env as a fallback, so if
# GEMINI_API_KEY / MONGODB_URI already live there you may not need to repeat them.

GEMINI_API_KEY=your_gemini_api_key_here
MONGODB_URI=mongodb://localhost:27017

# Model + currency for approximate pricing
GEMINI_MODEL=gemini-2.5-flash
PRICE_CURRENCY=INR
