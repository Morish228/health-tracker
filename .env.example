# Copy to .env on the server and fill in real values. NEVER commit .env.

# --- Public URL (DuckDNS subdomain pointing at the EC2 Elastic IP) ---
PUBLIC_HOST=yoursub.duckdns.org
PUBLIC_URL=https://yoursub.duckdns.org

# --- Database (MongoDB Atlas) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/test?retryWrites=true&w=majority

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_long_random

# --- API keys (use freshly rotated keys) ---
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=...
TAVILY_API_KEY=tvly-...

# --- Model config ---
GEMINI_MODEL=gemini-2.5-flash
STRONG_MODEL=llama-3.3-70b-versatile
FAST_MODEL=llama-3.1-8b-instant
WHISPER_MODEL=whisper-large-v3

NODE_ENV=production
